# העתיקו ל-.env.local לפיתוח מקומי, או הגדירו ב-Vercel → Settings → Environment Variables

# ---------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------

# סיסמת כניסה לאתר. אם ריק → גישה פתוחה (dev only).
ACCESS_PASSWORD=

# מחרוזת אקראית ארוכה (32+ תווים) — חתימת token לעוגיית auth.
# חובה בפרודקשן! אל תשתמשו בערך הדיפולט.
AUTH_SECRET=

# ---------------------------------------------------------------
# Persistence — GitHub (recommended, default)
# ---------------------------------------------------------------
# מימושים נשמרים בקובץ data/redeems.json בריפו דרך GitHub Contents API.
# יתרונות:
#   * עמיד בין deployments, בין cold starts, ובעת logout.
#   * audit מלא בהיסטוריית git.
#   * אין צורך ב-DB חיצוני.
# commits כוללים [skip ci] כדי לא להפעיל deploy מחדש על כל מימוש.
#
# יצירת token: github.com/settings/personal-access-tokens/new
#   Repository access: Only select repositories → בחרו את הריפו של הפרויקט
#   Permissions → Repository → Contents: Read and write
GITHUB_TOKEN=
# פורמט: owner/repo (לדוגמה: dandary/participants)
GITHUB_REPO=
# ברירת מחדל: main
GITHUB_BRANCH=main
# ברירת מחדל: data/redeems.json
GITHUB_REDEEMS_PATH=data/redeems.json
# (אופציונלי) זהות commit
GITHUB_COMMIT_NAME=WineNot Ops Bot
GITHUB_COMMIT_EMAIL=ops@winenot.local

# ---------------------------------------------------------------
# Persistence — Upstash Redis (alternative, optional)
# ---------------------------------------------------------------
# חלופה ל-GitHub. אם יש GITHUB_TOKEN+GITHUB_REPO — GitHub מקבל עדיפות.
# יצירה: https://console.upstash.com → Create database → REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------
# Order of preference at runtime:
#   1) GitHub (if GITHUB_TOKEN + GITHUB_REPO are set)
#   2) Upstash Redis (if UPSTASH_REDIS_REST_URL + TOKEN are set)
#   3) In-memory (volatile — shows a warning banner in the UI)
# ---------------------------------------------------------------
